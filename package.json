{
  "name": "bbb-stress-tool",
  "version": "0.1.0",
  "private": true,
  "description": "Load tests for BigBlueButton with real browser clients",
  "repository": "github:laserrapt0r/bbb-stresstest-tool",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/controller/public dist/controller/public",
